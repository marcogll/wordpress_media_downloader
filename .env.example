# WordPress Media Downloader Configuration
# Copy this file to .env and fill in your details:
#   cp .env.example .env

# WordPress site URL (no trailing slash)
WP_SITE_URL=https://yoursite.com

# WordPress username (must have access to the media library)
WP_USERNAME=your_username

# Application Password (NOT your regular password)
# Create one at: WP Admin > Users > Profile > Application Passwords
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Local directory where files will be downloaded
DOWNLOAD_DIR=./downloads

# Save a .json metadata file alongside each downloaded file
# Contains: title, description, caption, alt_text, mime_type, etc.
SAVE_METADATA=true

# Preserve the year/month folder structure from wp-content/uploads/
PRESERVE_STRUCTURE=true
